# Vader and the Slack bot each have their own env file, so neither holds the other's secrets.
# Copy the two blocks below into .env.vader and .env.slack. VADER_API_KEY must match in both
# (generate one: python -c "import secrets; print(secrets.token_urlsafe(32))").

# .env.vader
VADER_API_KEY=change-me
VADER_HOST=127.0.0.1
VADER_PORT=8700
OLLAMA_URL=http://localhost:11434
# Keep in step with the server's context window (Ollama: OLLAMA_CONTEXT_LENGTH)
LLM_CONTEXT_TOKENS=32768
# Reply budget; reasoning models (gpt-oss, phi4-reasoning) spend part of it thinking
LLM_OUTPUT_TOKENS=12288
LLM_TIMEOUT_SECONDS=600
# Max minutes per review; 0 = no limit (use 0 on fast hardware: Mac mini / RTX PRO 6000)
REVIEW_TIME_LIMIT_MINUTES=30
# Severities re-checked before posting (empty = off)
VERIFY_SEVERITIES=critical,high
# GitHub: fine-grained token on these repos only: Contents: Read, Issues: Read, Checks: Read,
# Pull requests: Read and write (write is only for posting the review comment)
GITHUB_TOKEN=
GITHUB_REPOS=owner/repo
POLL_SECONDS=60
REVIEW_DRAFTS=false
# Post each PR review as a PR comment (token needs Pull requests: Read and write)
GITHUB_COMMENT=true
REQUIRE_CI=false

# .env.slack
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
VADER_URL=http://127.0.0.1:8700
VADER_API_KEY=change-me
# Channel ID for automatic PR reviews and alerts
SLACK_NOTIFY_CHANNEL=
