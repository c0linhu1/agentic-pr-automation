# Vader and the Slack bot each have their own env file, so neither holds the other's secrets.
# Copy the two blocks below into .env.vader and .env.slack. VADER_API_KEY must match in both
# (generate one: python -c "import secrets; print(secrets.token_urlsafe(32))").

# .env.vader
VADER_API_KEY=change-me
VADER_HOST=127.0.0.1
VADER_PORT=8700
# Any OpenAI-compatible model server: Ollama http://localhost:11434/v1, LM Studio http://localhost:1234/v1
LLM_BASE_URL=http://localhost:11434/v1
# generic: the server loads models itself (LM Studio, vLLM, llama.cpp)
# ollama: Vader loads one model at a time through Ollama's own API and checks its context
MODEL_RUNTIME=ollama
# Keep in step with the server's context window (Ollama: OLLAMA_CONTEXT_LENGTH)
LLM_CONTEXT_TOKENS=32768
# Reply budget; reasoning models (gpt-oss, Qwen) spend part of it thinking
LLM_OUTPUT_TOKENS=12288
LLM_TIMEOUT_SECONDS=600
# Max minutes per review; 0 = no limit
REVIEW_TIME_LIMIT_MINUTES=30
# Severities re-checked before posting (empty = off)
VERIFY_SEVERITIES=critical,high
# Validators asked several times per review, findings combined (e.g. correctness=3; empty = once each).
# A finding below high that most asks didn't report goes to the verify pass
VALIDATOR_ASKS=
# GitHub: fine-grained token on these repos only: Contents: Read and write (write is for auto-merge),
# Issues: Read and write (write is for closing linked issues), Checks: Read,
# Pull requests: Read and write (the review comment and merging)
GITHUB_TOKEN=
GITHUB_REPOS=owner/repo
POLL_SECONDS=60
REVIEW_DRAFTS=false
# Post each PR review as a PR comment (token needs Pull requests: Read and write)
GITHUB_COMMENT=true
# Merge PRs into this branch after a PASS from all six validators with CI passed (e.g. staging); empty = off
AUTO_MERGE_BRANCH=
# Paths a person always reviews: a PR changing one is never auto-merged, however clean the review.
# Comma-separated globs; `**` spans folders, a name without `/` matches in any folder
NEEDS_PERSON_PATHS=
# Private package hosts to trust in lockfiles, comma-separated (public registries are built in; adding
# github.com allows git dependencies, and with them any fork someone points a lockfile at)
TRUSTED_PACKAGE_HOSTS=
# Close the issues a PR links ("Closes #12") when the PR is closed, merged or not
CLOSE_LINKED_ISSUES=true
# Missing CI results hold a release
REQUIRE_CI=false
# Advanced, rarely changed (defaults shown; set paths are relative to the folder Vader starts in):
# Ollama's own API, if it isn't at LLM_BASE_URL without /v1
#OLLAMA_URL=http://localhost:11434
# Only for a server that checks keys; the OpenAI SDK needs some value even locally
#LLM_API_KEY=local
# Times to re-ask after a reply in the wrong shape
#PARSE_RETRIES=1
# Where unusable replies are saved for debugging; empty turns it off
#FAILED_REPLIES_DIR=failed_replies
#SKILLS_DIR=skills
#MODELS_FILE=models.yaml
#STATE_FILE=vader_state.json
# GitHub Enterprise: https://your-host/api/v3
#GITHUB_API=https://api.github.com

# .env.slack
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
VADER_URL=http://127.0.0.1:8700
VADER_API_KEY=change-me
# Channel ID for automatic PR reviews and alerts
SLACK_NOTIFY_CHANNEL=
