SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# Any OpenAI-compatible server: Ollama (default), LM Studio (http://localhost:1234/v1), llama-server, vLLM
LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT_SECONDS=300
# Keep in step with the server's context window (Ollama: OLLAMA_CONTEXT_LENGTH)
LLM_CONTEXT_TOKENS=4096
LLM_OUTPUT_TOKENS=1024
MAX_WORKERS=2
